--[[
  Loot gesture: this player's body kneels while they loot a corpse, a stash or a
  mutant, as their avatar on the other machines and in their own third person.
  Only edges are sent; XrrPhasedGesture plays in / idle / out on each body and
  releases the kneel on movement.
]]

local BASE = "xrr_leer_search"
local ENTER, CONFIRM, EXIT = 0, 1, 2

-- A stash whose origin sits higher than this above the actor's feet is looted standing.
local MAX_KNEEL_BOX_HEIGHT = 0.6

local enter_t = -1
local in_loot = false
local looted  = false

-- An ENTER is out with no terminal edge yet. ENTER itself is never gated on it: a
-- mutant use that opens no UI sends no terminal edge.
local active = false

local function in_session()
    return XrrIsHosted() or XrrIsConnected()
end

local function send_enter()
    -- The host's use → start → GUI_on_show chain runs in one frame.
    local now = time_global()
    if now == enter_t then return end
    enter_t = now
    active  = true
    looted  = false
    in_loot = false
    XrrPlayers():SendPeerGesture(BASE, ENTER)
end

local function send_terminal(edge)
    if not active then return end
    active = false
    if in_session() then
        XrrPlayers():SendPeerGesture(BASE, edge)
    end
end

local function send_mutant_terminal()
    send_terminal(looted and CONFIRM or EXIT)
    looted = false
end

local function on_gui_show(name)
    if not in_session() then return end
    if name == "UIInventory" then
        -- A companion's inventory is loot mode too.
        local gui = ui_inventory.GUI
        if not (gui and gui.mode == "loot") then return end
        local obj = gui.npc_id and level.object_by_id(gui.npc_id)
        if not obj then return end
        if gui.npc_is_box then
            if obj:position().y - db.actor:position().y <= MAX_KNEEL_BOX_HEIGHT then
                send_enter()
            end
        elseif IsStalker(obj) and not obj:alive() then
            send_enter()
        end
    elseif name == "UIMutantLoot" then
        -- A peer's UI opens only after the host round-trip, which the player may have walked through.
        send_enter()
    end
end

-- Loot closes the UI from inside itself, so its own wrap sends that edge.
local function on_gui_hide(name)
    if name == "UIMutantLoot" and not in_loot then
        send_mutant_terminal()
    end
end

local function on_actor_menu_mode(mode, last_mode)
    if mode == 0 and last_mode == 4 then
        send_terminal(EXIT)
    end
end

-- Raised only past bind_monster's knife gate.
local function monster_on_actor_use(obj, who)
    if not in_session() then return end
    if who and who:id() == AC_ID then
        send_enter()
    end
end

local function loot_count(loot)
    local n = 0
    for _, t in pairs(loot or {}) do
        n = n + (t.count or 0)
    end
    return n
end

-- Redone's auto_loot_all calls Loot on a UI it never registers, so no GUI_on_hide
-- fires; the UI's state is read from IsShown after the call. That Loot can run inside
-- ui_mutant_loot's use callback, ahead of this module's, so it raises its own ENTER.
local function wrap_mutant_loot()
    local orig = ui_mutant_loot.UIMutantLoot.Loot
    ui_mutant_loot.UIMutantLoot.Loot = function(self, ...)
        if not in_session() then return orig(self, ...) end
        if not self:IsShown() then send_enter() end
        in_loot = true
        local before = loot_count(self.loot)
        orig(self, ...)
        in_loot = false
        if loot_count(self.loot) < before then
            looted = true
        end
        if not self:IsShown() then
            send_mutant_terminal()
        end
    end
end

function on_game_start()
    RegisterScriptCallback("GUI_on_show",                   on_gui_show)
    RegisterScriptCallback("GUI_on_hide",                   on_gui_hide)
    RegisterScriptCallback("ActorMenu_on_mode_changed",     on_actor_menu_mode)
    RegisterScriptCallback("monster_on_actor_use_callback", monster_on_actor_use)
    wrap_mutant_loot()
end
