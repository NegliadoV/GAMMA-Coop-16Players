--[[
  xrRazom — STALKER Anomaly Co-op
  Разом нас багато. (Together we are many.)

  Zone Customization Project (smr_*) patch: bonus loot is generated by the host
  alone, and the world-simulation MCM pages are host-authored.
]]

local _applied = false

function on_game_start()
    if _applied then return end
    _applied = true

    -- Independent of smr_loot: the spawn/population pages are the world
    -- simulation, and a loadout can carry them without the loot module.
    if smr_amain_mcm then
        xrr_mcm_authority.declare("SMR", "host")
        xrr_mcm_authority.declare("SMR/smr_amain/smr_debug_log", "local") -- log verbosity only
        xrr_mcm_authority.declare("SMR/smr_loot/send_message", "local")   -- PDA news + sound pref
    end

    if not smr_loot then return end

    local orig_try_spawn = smr_loot.try_spawn
    if type(orig_try_spawn) ~= "function" then
        printe("![xrRazom][zcp] INSTALL FAILED: smr_loot.try_spawn missing — the "
            .. "client loot generator is unguarded")
        return
    end
    -- Both loot callbacks reach try_spawn by name; on a peer it derefs the nil
    -- alife_create_item returns under the spawn gate, and the host sends the loot.
    smr_loot.try_spawn = function(box)
        if XrrIsConnected() then return end
        return orig_try_spawn(box)
    end

    -- try_spawn reaches this by name, so the host's run for a peer's box is
    -- covered; the mag roll keys on db.actor's weapons, the host's, so skip it.
    local orig_try_spawn_mag = smr_loot.try_spawn_mag
    if type(orig_try_spawn_mag) == "function" then
        smr_loot.try_spawn_mag = function(box)
            if xrr_host_box_open_for_peer and xrr_host_box_open_for_peer() then return end
            return orig_try_spawn_mag(box)
        end
    end

    -- send_message drives pda_message, whose give_game_news lands on whoever is
    -- db.actor. During a peer's box open that is the host, who opened nothing.
    local orig_get_config = smr_loot_mcm and smr_loot_mcm.get_config
    if type(orig_get_config) == "function" then
        smr_loot_mcm.get_config = function(key)
            if key == "send_message" and xrr_host_box_open_for_peer
               and xrr_host_box_open_for_peer() then
                return false
            end
            return orig_get_config(key)
        end
    end

    log("[xrRazom][zcp] client loot-generator suppression installed")
end
