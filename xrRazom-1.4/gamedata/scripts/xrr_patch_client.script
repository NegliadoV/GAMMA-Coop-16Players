--[[
  xrRazom — STALKER Anomaly Co-op
  Разом нас багато. (Together we are many.)

  Module: Client Patch — disables all simulation systems that the host controls.
]]

local NOP         = function() end
local RETURN_TRUE  = function() return true end
local RETURN_FALSE = function() return false end

-- axr_main's registry keys on the function OBJECT; overwriting the field does nothing.
local function unregister_cb(name, tbl, field)
    local fn = tbl and tbl[field]
    if type(fn) ~= "function" then return false end
    UnregisterScriptCallback(name, fn)
    return true
end

-- Stub id for a forwarded sleeping-bag deploy: u16(-1), the engine's invalid id.
local XRR_SLEEPBAG_STUB_ID = 65535

-- Captured in apply(), after every mod's file-scope replacement of them.
local _old_item_parts_evaluate
local _old_item_parts_func_disassembly
local _old_utils_item_detach_addon

-- Mirror of item_parts' file-local d_flag (the Alt-hold disassembly safety).
local xrr_dis_key_flag = false

local _mutant_orig_start = nil
local _mutant_remote_id  = nil   -- local corpse id while a host-mediated loot UI is up
local _mutant_close_tbl  = nil
local _mutant_ea_wait    = nil   -- corpse id whose STATE waits for EA's anim-end re-entry
local _mutant_ea_local   = nil   -- corpse id whose EA re-entry is vanilla-local (crow)
local _mutant_ea_roll    = nil   -- corpse id whose EA re-entry rolls (verdict 4)

function apply()
    _old_item_parts_evaluate         = item_parts.evaluate_parts
    _old_item_parts_func_disassembly = item_parts.func_disassembly
    _old_utils_item_detach_addon     = utils_item.detach_addon

    -- Vanilla's queue keys on a raw id, so a recycled id releases someone else's
    -- entity; its table is file-local, hence both entry points are replaced.
    if safe_release_manager and not safe_release_manager._xrr_fingerprinted then
        local pending = {}   -- id -> section fingerprint at queue time

        safe_release_manager.release = function(se_obj)
            if not se_obj then return end
            local ok, sec = pcall(function() return se_obj:section_name() end)
            sec = ok and sec or "?"

            -- The gate must sit here, not in the drain: the drain's online arm
            -- force-switches the entity offline before any release runs.
            if XrrIsConnected() and xrr_is_host_owned(se_obj.id) then
                printf("[xrRazom][srm] refused host-owned id=%s sec=%s parent=%s",
                       tostring(se_obj.id), tostring(sec), tostring(se_obj.parent_id))
                return
            end

            pending[se_obj.id] = sec
            printf("[xrRazom][srm] queued id=%s sec=%s online=%s",
                   tostring(se_obj.id), tostring(sec), tostring(se_obj.online))
        end

        safe_release_manager.execute_destroy_callback = function()
            if is_empty(pending) then return false end
            local sim = alife()
            if not sim then return false end

            for id, want_sec in pairs(pending) do
                local se_obj = alife_object(id)
                if not se_obj then
                    pending[id] = nil
                else
                    local ok, sec = pcall(function() return se_obj:section_name() end)
                    if ok and sec ~= want_sec then
                        printf("[xrRazom][srm] id=%s recycled (%s -> %s) - entry dropped, NOT releasing",
                               tostring(id), tostring(want_sec), tostring(sec))
                        pending[id] = nil
                    elseif se_obj.online then
                        sim:set_switch_online(id, false)
                        sim:set_switch_offline(id, true)
                        se_obj:switch_offline()
                    else
                        local obj = db.storage[id] and db.storage[id].object
                        if not obj then
                            alife_record(se_obj, false)
                            sim:release(se_obj, true)
                            pending[id] = nil
                        end
                    end
                end
            end
            return false
        end

        AddUniqueCall(safe_release_manager.execute_destroy_callback)
        safe_release_manager._xrr_fingerprinted = true
        printf("[xrRazom][srm] deferred-release queue is now id+section fingerprinted")
    end

    -- Would release host-owned ground items; stays armed so vanilla resumes after the session.
    if release_item_manager and release_item_manager.clear
        and not release_item_manager._xrr_peer_gated then
        local orig_clear = release_item_manager.clear
        release_item_manager.clear = function()
            if XrrIsConnected() then
                ResetTimeEvent(0, "release_item", 5)
                return false
            end
            return orig_clear()
        end
        release_item_manager._xrr_peer_gated = true
        printf("[xrRazom] release_item_manager.clear() is now peer-session-gated")
    end

    -- The new-game flow loads the level twice and leaves loaded = true over empty
    -- state; initialize_obj must re-derive through determine_section_to_activate.
    local _orig_phys_update = bind_physic_object.generic_physics_binder.update
    bind_physic_object.generic_physics_binder.update = function(self, delta)
        if not self.initialized and db.actor then
            self.loaded = false
        end
        _orig_phys_update(self, delta)
    end

    local _orig_restr_update = bind_restrictor.restrictor_binder.update
    bind_restrictor.restrictor_binder.update = function(self, delta)
        if not self.initialized and db.actor then
            self.loaded = false
        end
        _orig_restr_update(self, delta)
    end

    -- Block all alife spawning on the client side.
    _G.alife_create = function(sec, pos, lid, gid, id, state)
        -- item_tent's sleepbag branch derefs se_obj.id inline: forward it, stub id.
        if not id and sec == "ph_sleepbag" and db.actor and XrrWorld then
            local p = pos or db.actor:position()
            XrrWorld():SendPeerStashDeploy(sec, p.x, p.y, p.z,
                lid or db.actor:level_vertex_id(), gid or db.actor:game_vertex_id(),
                ui_item.get_sec_name("itm_sleepbag"), "ui_pda2_actor_sleep_location", "")
            return { id = XRR_SLEEPBAG_STUB_ID }
        end
        if id or (sec and string.match(sec, "level_changer")) then
            return alife():xrr_create_direct(sec, pos, lid, gid, id, state)
        end
    end

    local function owner_is_local_actor(owner)
        if not (owner and db.actor) then return false end
        if type(owner) == "table" then return owner[4] == AC_ID end
        if type(owner.id) == "function" then return owner:id() == AC_ID end
        return owner.id == AC_ID
    end

    -- ItemProcessor accepts "section__uses"; the client-spawn wants a bare section.
    local function extract_uses(section)
        local sec, uses = string.match(section, "^(.*)__(%d)$")
        if sec and ini_sys:section_exist(sec) then return sec, tonumber(uses) end
        return section
    end

    -- The peer's own items spawn via xrr_spawn_actor_item instead of dying on the
    -- block above; t.ammo lands as one box, not vanilla's split.
    local _orig_create_item = _G.alife_create_item
    _G.alife_create_item = function(section, owner, t)
        if not (section and owner_is_local_actor(owner)) then
            return _orig_create_item(section, owner, t)
        end
        local sec, uses = extract_uses(section)
        local id = xrr_spawn_actor_item(sec)
        if id == -1 then
            printe("![xrRazom] client-spawn refused [%s] for the local actor", tostring(sec))
            return
        end
        if uses then alife_process_item(sec, id, { uses = uses }) end
        if t then alife_process_item(sec, id, t) end
        return alife_object(id)
    end

    -- Stub id only: vanilla sleep zones share the spot type.
    local _xrr_orig_map_add_ser = level.map_add_object_spot_ser
    level.map_add_object_spot_ser = function(spot_id, spot, text)
        if spot_id == XRR_SLEEPBAG_STUB_ID then return end
        return _xrr_orig_map_add_ser(spot_id, spot, text)
    end

    -- Blocks every Lua-facing alife():create / register at the binding.
    XrrNet():SetClientCreateGate(true)
    xrr_register_cleanup(function() XrrNet():SetClientCreateGate(false) end)

    -- bar_arena_teleport's loadout alife_create is a no-op here: capture and re-spawn.
    if xr_effects and type(xr_effects.bar_arena_teleport) == "function" then
        local _orig_arena_tp = xr_effects.bar_arena_teleport
        local _orig_ac       = _G.alife_create
        local _capturing     = nil

        _G.alife_create = function(sec, pos, lid, gid, id, state)
            if _capturing and sec then
                _capturing[#_capturing + 1] = sec
            end
            return _orig_ac(sec, pos, lid, gid, id, state)
        end

        xr_effects.bar_arena_teleport = function(actor, npc, p)
            _capturing = {}
            _orig_arena_tp(actor, npc, p)
            local loadout = _capturing
            _capturing = nil
            local n = 0
            for _, sec in ipairs(loadout) do
                if xrr_spawn_actor_item(sec) ~= -1 then n = n + 1 end
            end
            printf("[xrRazom] arena: peer match loadout = %s/%s item(s) via client-spawn",
                   tostring(n), tostring(#loadout))
        end
    end

    -- Vanilla mints the per-part table on whichever machine looks first; the peer
    -- mints only its own inventory's, host-owned ones arrive minted.
    item_parts.evaluate_parts = function(obj)
        local parent = obj and obj:parent()
        if parent and parent:id() == AC_ID then
            return _old_item_parts_evaluate(obj)
        end
    end

    -- A detach inside a box/corpse is forwarded: the addon spawns into the
    -- CONTAINER and section-swap weapons clone via alife():register, both gated.
    utils_item.detach_addon = function(wpn, addon, typ, ignore)
        local parent = wpn and wpn:parent()
        if parent and parent:id() ~= AC_ID then
            local typ_code = (typ == "scope" and 0) or (typ == "sil" and 1) or (typ == "gl" and 2)
            if typ_code then
                XrrWorld():SendContainerDetach(parent:id(), wpn:id(), typ_code)
            end
            return
        end
        return _old_utils_item_detach_addon(wpn, addon, typ, ignore)
    end

    -- Forwarded like detach: parts spawn into the item's PARENT container. Tool
    -- wear is local and optimistic; a refused forward costs one use.
    item_parts.func_disassembly = function(obj, obj_d)
        local parent = obj and obj:parent()
        if parent and parent:id() ~= AC_ID then
            obj_d = obj_d or item_parts.get_suitable_dtool(obj)
            if not item_parts.is_suitable_dtool(obj, obj_d) then
                if IsWeapon(obj) then
                    actor_menu.set_item_news('fail', 'weapon', "st_dis_text_3", " ")
                else
                    news_manager.send_tip(db.actor,
                        game.translate_string("st_news_dis_items"), nil, "swiss_knife", 6000)
                end
                return
            end
            local chk = ui_options.get("control/general/disassembly_warning")
            if chk and (not xrr_dis_key_flag) then
                actor_menu.set_item_news("success", "detail", "st_awr_ctrl")
                return
            end
            local diss_tools = GetItemList("disassemble")
            utils_item.degrade(obj_d, diss_tools[obj_d:section()])
            game_statistics.increment_statistic("items_disassembled")
            actor_effects.play_item_fx("disassemble_metal_fast")
            XrrWorld():SendContainerDisassemble(parent:id(), obj:id(), obj_d:section())
            return
        end
        return _old_item_parts_func_disassembly(obj, obj_d)
    end

    RegisterScriptCallback("on_key_press", function(key)
        if key == DIK_keys["DIK_LMENU"] then xrr_dis_key_flag = true end
    end)
    RegisterScriptCallback("on_key_release", function(key)
        if key == DIK_keys["DIK_LMENU"] then xrr_dis_key_flag = false end
    end)

    -- create_release_item stays live for mod wrappers; these leaves gut its body.
    death_manager.create_item            = NOP
    death_manager.try_spawn_ammo         = NOP
    death_manager.spawn_cosmetics        = NOP
    death_manager.set_weapon_drop_condition = NOP
    death_manager.keep_item              = RETURN_FALSE
    -- Money is minted host-side; converting here would mint a divergent amount.
    item_money.actor_on_loot_money       = NOP
    -- The story-id branch evaluates a condlist, and %+info% side effects
    -- replicate. init_drop_settings refills the table at every actor spawn.
    death_manager.item_by_story_id       = {}
    local _xrr_orig_init_drop_settings   = death_manager.init_drop_settings
    death_manager.init_drop_settings = function(...)
        _xrr_orig_init_drop_settings(...)
        death_manager.item_by_story_id = {}
    end
    treasure_manager.try_spawn_treasure  = NOP
    -- Stash loot rolls an independent math.random per machine.
    treasure_manager.create_random_stash = NOP
    xrs_rnd_npc_loadout.create_item_on_npc = NOP
    itms_manager.new_game_equippment = function()
        if not has_alife_info("start_equippment_handled") then
            give_info("start_equippment_handled")
        end
        printf("[xrRazom] new_game_equippment suppressed for peer (inventory is host-restored)")
        -- true, or delay_new_game_autosave's time event re-fires every tick
        return true
    end
    -- The peer's DESTROYABLE_DESTROY handler fires eDeath too; box loot is the host's.
    function xr_box.ph_item_box:spawn_items() end
    -- Vanilla bug: factions_table_all's column order mismatches game_relations.ltx;
    -- the C++ table is already correct.
    game_relations.reset_all_relations   = function() end
    guaranteed_loot.check                = NOP
    guaranteed_loot.npc_on_use           = NOP
    guaranteed_loot.on_game_start        = NOP
    xr_logic.create_items                = NOP
    xr_logic.spawn_items                 = NOP

    -- A mirror runs no logic, so its local trade_init is the trade_generic fallback.
    local _orig_trade_init = trade_manager.trade_init
    trade_manager.trade_init = function(npc, cfg)
        local forced = npc and XrrTraderProfiles and XrrTraderProfiles[npc:id()]
        return _orig_trade_init(npc, forced or cfg)
    end

    -- A peer has no restock schedule. Replaced, not wrapped, so mod restock tails
    -- (GAMMA's trader_autoinject) drop out of the chain.
    trade_manager.update = function(npc)
        local id     = npc and npc:id()
        local cfg    = id and trade_manager.get_trade_profile(id, "cfg_ltx")
        local config = cfg and trade_manager.get_trade_cfg(cfg)
        if config then trade_manager.setup_buy_sell_conditions(npc, id, config) end
    end

    -- A mirror never has the `trade` logic line vanilla reads; the host ships the
    -- verdict as the NPC_FLAGS trader bit.
    local _orig_is_trader = utils_obj.is_trader
    utils_obj.is_trader = function(...)
        local npc = ...
        if npc and XrrAlife():IsNpcTrader(npc:id()) then return true end
        return _orig_is_trader(...)
    end

    ui_debug_launcher.release_obj = function()
        local obj = level.get_target_obj()
        if not obj then return end
        local name = obj:name()
        alife_release_client_id(obj:id())
        printf("-[xrRazom] %s despawned via client", name)
    end

    -- Task fail is host-authoritative: only a forced status fails, never a local condlist.
    function task_manager.CRandomTask:task_fail(p1)
        if db.actor == nil or device().precache_frame > 1 then return false end
        local tsk = self.task_info[p1]
        if not tsk or tsk.forced_status ~= "fail" then return false end
        tsk.forced_status = nil
        tsk.last_check_task = "fail"
        return true
    end

    -- tasks_defense state lives in mdata, absent on a fresh-join peer (nil-index
    -- fatal): seed the default. The announce roll is host-owned.
    tasks_defense.load_state({})
    UnregisterScriptCallback("actor_on_first_update", tasks_defense.actor_on_first_update)
    tasks_defense.actor_on_first_update = NOP

    game_setup.try_spawn_world_item = NOP
    ph_door.try_to_open_door        = NOP
    ph_door.try_to_close_door       = NOP


    task_functor.smart_control_task_target_functor = NOP
    tasks_clear_map.mutants_in_map                 = NOP

    state_mgr_direction.turn          = NOP
    state_mgr_direction.look_at_object = NOP

    xr_effects.set_weather     = NOP
    xr_effects.setup_companion_task = NOP
    xr_effects.spawn_corpse    = NOP
    utils_obj.create_squad     = NOP

    -- Gear-gated scripted kills re-evaluate every tick, and a rejoin lands before
    -- the host's gear does. Deferred, not bypassed.
    local _kill_actor = xr_effects.kill_actor
    xr_effects.kill_actor = function(actor, npc, p)
        if XrrNet():JoinSettling() then
            printf("[xrRazom] kill_actor deferred — world/gear restore still in flight")
            return
        end
        _kill_actor(actor, npc, p)
    end

    bind_anomaly_field.load_state         = NOP
    bind_anomaly_field.dyn_anomalies_refresh = NOP
    bind_anomaly_field.dyn_anomalies_suffle  = NOP
    bind_anomaly_field.dyn_anomalies_update  = NOP
    bind_anomaly_field.dyn_anomalies_spawn   = NOP
    bind_anomaly_zone.force_spawn_artefacts  = NOP

    pda.npc_on_net_spawn = NOP

    dialogs.drx_sl_give_sl_task = NOP

    sim_squad_bounty.try_spawn    = NOP
    sim_squad_bounty.spawn_timer  = RETURN_TRUE
    sim_squad_bounty.state_timer  = RETURN_TRUE
    sim_squad_bounty.on_game_start = NOP
    tasks_chimera_scan.spawn_on_squad_member = NOP


    alife_storage_manager.get_state().stop_respawns = true

    function sim_board.simulation_board:create_squad()             return nil end
    function sim_board.simulation_board:create_squad_at_named_location() return nil end
    function sim_board.simulation_board:assign_squad_to_smart()   return nil end

    -- The whole method goes, SendScriptCallback included: mod hooks there spawn
    -- through the gated creators and deref the nil back.
    function sim_board.simulation_board:fill_start_position()      return nil end

    -- warfare's save_state / load_state stay: peer-local persistence.
    unregister_cb("smart_terrain_on_update",     smart_terrain_warfare, "smart_terrain_on_update")
    unregister_cb("squad_on_update",             sim_squad_warfare,     "squad_on_update")
    unregister_cb("squad_on_npc_death",          sim_squad_warfare,     "squad_on_npc_death")
    unregister_cb("actor_on_update",             warfare,               "actor_on_update")
    unregister_cb("server_entity_on_unregister", warfare,               "squad_on_unregister")

    -- Only the actor-local dist_to_actor / nearest_to_actor_smart bookkeeping
    -- stays: condlists and mods read it.
    function smart_terrain.se_smart_terrain:try_respawn() end
    function smart_terrain.se_smart_terrain:update()
        local se_actor = alife():actor()
        self.dist_to_actor = self.online and self.position:distance_to(se_actor.position) or math.huge

        if self.online then
            local nearest = smart_terrain.nearest_to_actor_smart
            if nearest.id then
                if nearest.id == self.id then
                    nearest.dist = self.dist_to_actor
                elseif self.dist_to_actor < nearest.dist then
                    nearest.id   = self.id
                    nearest.dist = self.dist_to_actor
                end
            else
                nearest.id   = self.id
                nearest.dist = self.dist_to_actor
            end
        end

        self.disabled = true
    end

    function mob_walker.mob_walker:update() end
    function mob_walker.mob_walker:waypoint_callback() end

    function sim_squad_scripted.sim_squad_scripted:update() end
    function sim_squad_scripted.sim_squad_scripted:check_online_status() end
    function sim_squad_scripted.sim_squad_scripted:remove_squad() end
    function sim_squad_scripted.sim_squad_scripted:sim_available() end

    -- Vanilla indexes the nil the client alife gate returns before any caller can
    -- test it; returning nil is the contract every caller already handles.
    function sim_squad_scripted.sim_squad_scripted:add_squad_member() end

    xr_conditions.validate_spy_task       = RETURN_FALSE
    task_status_functor.spy_task_status_functor = NOP
    utils_obj.switch_online               = NOP
    task_functor.spy_task_target_functor  = function(task_id, field, p, tsk)
        if not (field == "target" and tsk and db.actor) then return end
        return tsk.current_target or tsk.task_giver_id
    end

    function bind_anomaly_zone.anomaly_zone_binder:spawn_artefact_randomly() end

    -- Dynamic news reaches the peer as the host's GAME_NEWS.
    function dynamic_news_manager.DynamicNewsManager:TickNews() return true end
    function dynamic_news_manager.DynamicNewsManager:TickQuick() return true end
    function dynamic_news_manager.DynamicNewsManager:TickSpecial() return true end
    function dynamic_news_manager.DynamicNewsManager:TickTask() return true end
    function dynamic_news_manager.DynamicNewsManager:TickRandom() return true end
    function dynamic_news_manager.DynamicNewsManager:TickCompanion() return true end
    function dynamic_news_manager.DynamicNewsManager:npc_on_death_callback() end
    function dynamic_news_manager.DynamicNewsManager:monster_on_death_callback() end
    function dynamic_news_manager.DynamicNewsManager:npc_on_get_all_from_corpse() end
    function dynamic_news_manager.DynamicNewsManager:WelcomeToNetwork() end
    function dynamic_news_manager.DynamicNewsManager:GossipTaskDRX() end
    function dynamic_news_manager.DynamicNewsManager:RadioInHeli() return false end

    function release_body_manager.Crelease_body:clear() end

    function xr_wounded.evaluator_wound:evaluate()       return false end

    -- No wounded scheme on a mirror; host wound state rides the pstor snapshot.
    local function pstor_wounded_state(npc_id)
        local st = db.storage[npc_id]
        local s = st and st.pstor and st.pstor.wounded_state
        return s ~= nil and tostring(s) or "nil"
    end
    function xr_wounded.is_wounded(npc)
        return npc ~= nil and pstor_wounded_state(npc:id()) ~= "nil"
    end
    function xr_wounded.is_heavy_wounded_by_id(npc_id)
        return pstor_wounded_state(npc_id) ~= "nil"
    end
    function xr_patrol.evaluator_patrol_end:evaluate()   return false end
    function xr_patrol.evaluator_patrol_comm:evaluate()  return false end
    function xr_patrol.action_patrol:execute()           action_base.execute(self) end
    function xr_patrol.action_commander:execute()        action_base.execute(self) end
    function xr_camper.action_patrol:process_danger()    end
