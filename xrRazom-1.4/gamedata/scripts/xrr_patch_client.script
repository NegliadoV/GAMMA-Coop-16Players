    function xr_combat_monolith.evaluator_combat_monolith:evaluate() return false end
    function xr_combat_monolith.evaluator_see:evaluate()             return false end
    function xr_combat_monolith.evaluator_close:evaluate()           return false end
    function xr_combat_monolith.evaluator_on_pos:evaluate()          return false end
    function xr_combat_zombied.evaluator_combat_zombied:evaluate()   return false end
