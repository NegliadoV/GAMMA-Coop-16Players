xrr_script_event.register("xrr:save_refused", function(args, sender)
    if db.actor and sender == "host" then
        actor_menu.set_msg(1, game.translate_string("st_xrr_save_refused_by_host"), 4)
    end
end)

-- Composed here so it resolves in this peer's locale.
-- kind 2 = transition wait, arg = the nick still loading.
_G.OnPeerScreenMsg = function(kind, arg)
    if not (db.actor and actor_menu and actor_menu.set_msg) then return end
    if kind == 2 then
        actor_menu.set_msg(1, string.format(game.translate_string("st_xrr_transition_waiting"),
                                            tostring(arg)), 4)
    end
end

-- The hint arrives in the host's locale: rebuild its durable part here. Count/timer lines
-- are add-time snapshots and are dropped.
_G.OnWarfareSpotApplied = function(id, spot_type)
    local ok, hint = pcall(function()
        local se = alife_object(id)
        if not se then return nil end

        local faction = string.sub(spot_type, 8)  -- strip "circle_"
        local stw  = smart_terrain_warfare
        local name = stw and stw.translate_smart_name(se:name())
        if not name or name == "" then name = se:name() end

        if not se.props and simulation_objects and simulation_objects.get_props then
            simulation_objects.get_props(se)
        end

        local clr_o  = utils_xml.get_color("d_orange")
        local clr_gr = utils_xml.get_color("ui_gray_1")
        local clr_w  = utils_xml.get_color("white")

        local t = clr_o .. name .. " \\n"
        t = t .. clr_o .. "................................\\n " .. clr_gr
        if faction ~= "empty" and faction ~= "target" then
            t = t .. " \n" .. clr_gr .. game.translate_string("st_wrfr_prop_faction")
                  .. ": " .. clr_w .. game.translate_string(faction) .. "\\n"
        end
        local p = se.props
        if p then
            if (p.base or 0) > 0 then
                t = t .. " \\n" .. clr_gr .. game.translate_string("st_wrfr_prop_base") .. " \\n"
            end
            if (p.resource or 0) > 0 then
                t = t .. " \\n" .. clr_gr .. game.translate_string("st_wrfr_prop_resource") .. " \\n"
            end
            if (p.territory or 0) > 0 then
                t = t .. " \\n" .. clr_gr .. game.translate_string("st_wrfr_prop_territory") .. " \\n"
            end
            if (p.lair or 0) > 0 then
                t = t .. " \\n" .. clr_gr .. game.translate_string("st_wrfr_prop_lair") .. " \\n"
            end
        end
        return t
    end)
    if ok and hint then
        level.map_change_spot_hint(id, spot_type, hint)
    end
end

function OnStatIncrement(key, count, rank_delta, rep_delta)
    if not game_statistics then return end
    for i = 1, count do
        game_statistics.increment_statistic(key,
            rank_delta ~= 0 and rank_delta or nil,
            rep_delta  ~= 0 and rep_delta  or nil)
    end
end

-- Peers have no save file, so the host persists this blob in PeerDb. Sorted keys keep it
-- deterministic for the C++ change-gate: "<key>:<count>;...|<level>,<level>,..."
function xrr_collect_stats_blob()
    if not game_statistics then return "" end
    local keys = {}
    for k in pairs(game_statistics.actor_statistics) do keys[#keys + 1] = k end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do
        local s = game_statistics.actor_statistics[k]
        parts[#parts + 1] = k .. ":" .. tostring((s and s.count) or 0)
    end
    local counts = table.concat(parts, ";")

    local lv = {}
    for k, v in pairs(game_statistics.actor_visited_levels) do
        if v == true then lv[#lv + 1] = k end
    end
    table.sort(lv)
    return counts .. "|" .. table.concat(lv, ",")
end

-- SET counts, never increment_statistic: restoring N kills must not re-award N× rank/rep.
function OnPeerStatsRestore(blob)
    if not game_statistics then return end
    if not blob or blob == "" then return end
    local counts_str, lv_str = blob:match("^(.-)|(.*)$")
    if counts_str then
        for k, c in counts_str:gmatch("([%w_]+):(%-?%d+)") do
            local s = game_statistics.actor_statistics[k]
            if s then s.count = tonumber(c) or 0 end
        end
    end
    if lv_str then
        for name in lv_str:gmatch("([%w_]+)") do
            if game_statistics.actor_visited_levels[name] ~= nil then
                game_statistics.actor_visited_levels[name] = true
            end
        end
    end
end

-- C++ already set rank/rep; re-baseline so the first increment pops no spurious news.
-- create_relations_tables covers a restore landing before on_game_start.
function OnPeerProgressRestore()
    if not (game_statistics and db.actor) then return end
    game_statistics.create_relations_tables()
    game_statistics.check_for_rank_change(true)
    game_statistics.check_for_reputation_change(true)
end

-- C++ gates and sends. IsConnected() is the peer-only predicate.
local _xrr_stats_next_push = 0
function xrr_stats_report_update()
    local mgr = XrrNet and XrrNet()
    if not (mgr and mgr:IsConnected()) then return end
    local now = time_global()
    if now < _xrr_stats_next_push then return end
    _xrr_stats_next_push = now + 1000
    XrrPlayers():SetLocalStatsBlob(xrr_collect_stats_blob())
end

-- Registered after game_statistics' on_level_changing (alphabetical load order), so the
-- push includes this transition's level_changes.
function xrr_stats_report_flush()
    local mgr = XrrNet and XrrNet()
    if not (mgr and mgr:IsConnected()) then return end
    _xrr_stats_next_push = time_global() + 1000
    XrrPlayers():SetLocalStatsBlob(xrr_collect_stats_blob())
end

-- Same round-trip as the stats blob: a fresh join actor starts at default condition.
-- Deterministic so the C++ change-gate can compare successive blobs.
function xrr_collect_condition_blob()
    -- GetSatiety(), not db.actor.satiety: the property reads 1.0/nil here.
    local sat = 1.0
    local cond = nil
    if db.actor then
        local act = db.actor:cast_Actor()
        cond = act and act:conditions()
        if cond then sat = cond:GetSatiety() end
    end

    local drink, sleep = 0, 0
    if actor_status_thirst and actor_status_thirst.save_state then
        local t = {}
        actor_status_thirst.save_state(t)
        if t.drink then drink = t.drink.last_drink or 0 end
    end
    if actor_status_sleep and actor_status_sleep.save_state then
        local t = {}
        actor_status_sleep.save_state(t)
        if t.sleep then sleep = t.sleep.last_sleep or 0 end
    end

    local base = string.format("sat:%.3f;drink:%d;sleep:%d",
        sat, math.floor(drink + 0.5), math.floor(sleep + 0.5))

    local boosts = {}
    if cond then
        cond:BoosterForEach(function(btype, btime, bvalue)
            if btime and btime > 0 then
                boosts[#boosts + 1] = string.format("%d,%.2f,%.4f", btype, btime, bvalue)
            end
        end)
    end
    if #boosts > 0 then
        base = base .. ";boost:" .. table.concat(boosts, "|")
    end

    -- Radiation has no CSE→spawn path, so it rides here. Health must not: it reaches the CSE
    -- via PLAYER_STATE, and a full-HP join actor's value would overwrite it.
    if db.actor then
        base = base .. string.format(";rad:%.3f", clamp(db.actor.radiation, 0, 1))
    end

    -- Bleeding speed depends on TotalSize() alone, so the aggregate restores faithfully.
    local wounds = {}
    if cond then
        cond:WoundForEach(function(w)
            local sz = w:TotalSize()
            if sz and sz > 0.001 then
                wounds[#wounds + 1] = string.format("%d,%.3f", w:GetBoneNum(), sz)
            end
        end)
    end
    if #wounds > 0 then
        base = base .. ";wnd:" .. table.concat(wounds, "|")
    end

    return base
end

-- Checkpoints stay nil so the next actor_on_update re-baselines them; a stale timestamp
-- would force a catch-up.
function OnPeerConditionRestore(blob)
    if not blob or blob == "" then return end
    local sat   = tonumber(blob:match("sat:([%-%d%.]+)"))
    local drink = tonumber(blob:match("drink:(%-?%d+)"))
    local sleep = tonumber(blob:match("sleep:(%-?%d+)"))

    if drink and actor_status_thirst and actor_status_thirst.load_state then
        actor_status_thirst.load_state({ drink = { last_drink = drink } })
    end
    if sleep and actor_status_sleep and actor_status_sleep.load_state then
        actor_status_sleep.load_state({ sleep = { last_sleep = sleep } })
    end

    -- CActorCondition::reinit() resets satiety and can land just after this: re-apply later.
    if db.actor and sat then
        local target = clamp(sat, 0, 1)
        db.actor.satiety = target
        local function reapply()
            if db.actor then db.actor.satiety = target end
            return true
        end
        CreateTimeEvent("xrr_cond_satiety", "reapply_1", 1, reapply)
        CreateTimeEvent("xrr_cond_satiety", "reapply_3", 3, reapply)
    end

    -- reinit() leaves boosters alone: one apply suffices. Empty sect = no use-sound.
    local bstr = blob:match("boost:([^;]*)")
    if bstr and bstr ~= "" and db.actor then
        local cond = db.actor:cast_Actor()
        cond = cond and cond:conditions()
        if cond then
            for entry in bstr:gmatch("[^|]+") do
                local t, tm, v = entry:match("(%-?%d+),([%-%d%.]+),([%-%d%.]+)")
                t, tm, v = tonumber(t), tonumber(tm), tonumber(v)
                if t and tm and v and tm > 0 and v > 0 then
                    local B = SBooster()
                    B.m_type      = t
                    B.fBoostTime  = tm
                    B.fBoostValue = v
                    cond:ApplyBooster(B, "")
                end
            end
        end
    end

    -- Same reinit() race as satiety; ClearWounds + exact sizes keep the re-apply idempotent.
    local rad = tonumber(blob:match("rad:([%d%.]+)"))
    local wnd = blob:match("wnd:([^;]*)")
    if rad or wnd then
        local function apply_vitals()
            if not db.actor then return true end
            if rad then db.actor.radiation = clamp(rad, 0, 1) end
            if wnd and wnd ~= "" then
                local act  = db.actor:cast_Actor()
                local cnd  = act and act:conditions()
                if cnd then
                    cnd:ClearWounds()
                    for entry in wnd:gmatch("[^|]+") do
                        local bone, sz = entry:match("(%d+),([%d%.]+)")
                        bone, sz = tonumber(bone), tonumber(sz)
                        if bone and sz and sz > 0 then
                            -- AddWound randomizes its initial size: open at 0, then AddHit.
                            if bone >= 64 then bone = 0 end -- engine bone cap
                            local w = cnd:AddWound(0, hit.wound, bone)
                            if w then w:AddHit(sz, hit.wound) end
                        end
                    end
                end
            end
            return true
        end
        apply_vitals()
        CreateTimeEvent("xrr_cond_vitals", "reapply_1", 1, apply_vitals)
        CreateTimeEvent("xrr_cond_vitals", "reapply_3", 3, apply_vitals)
    end
end

local _xrr_cond_next_push = 0
function xrr_condition_report_update()
    local mgr = XrrNet and XrrNet()
    if not (mgr and mgr:IsConnected()) then return end
    local now = time_global()
    if now < _xrr_cond_next_push then return end
    _xrr_cond_next_push = now + 5000
    XrrPlayers():SetLocalConditionBlob(xrr_collect_condition_blob())
end

-- Force a push before a level transition tears the Lua VM down.
function xrr_condition_report_flush()
    local mgr = XrrNet and XrrNet()
    if not (mgr and mgr:IsConnected()) then return end
    _xrr_cond_next_push = time_global() + 5000
    XrrPlayers():SetLocalConditionBlob(xrr_collect_condition_blob())
end

function OnRankingResponse(blob)
    if xrr_patch_pda and xrr_patch_pda.on_ranking_response then
        xrr_patch_pda.on_ranking_response(blob)
    end
end

function OnPdaInfo(blob)
    if xrr_patch_pda and xrr_patch_pda.on_pda_info then
        xrr_patch_pda.on_pda_info(blob)
    end
end

function OnRfBind(blob)
    if xrr_patch_radio and xrr_patch_radio.on_rf_bind then
        xrr_patch_radio.on_rf_bind(blob)
    end
end

function OnRadioChannelState(channel, kind, name)
    if xrr_patch_radio_fm and xrr_patch_radio_fm.on_channel_state then
        xrr_patch_radio_fm.on_channel_state(channel, kind, name)
    end
end

_G.OnStatIncrement      = OnStatIncrement
_G.OnRankingResponse    = OnRankingResponse
_G.OnPdaInfo            = OnPdaInfo
_G.OnRfBind             = OnRfBind
_G.OnRadioChannelState  = OnRadioChannelState

_G.OnPeerStatsRestore      = OnPeerStatsRestore
_G.OnPeerProgressRestore   = OnPeerProgressRestore
_G.xrr_stats_report_update = xrr_stats_report_update
_G.xrr_stats_report_flush  = xrr_stats_report_flush

_G.OnPeerConditionRestore      = OnPeerConditionRestore
_G.xrr_condition_report_update = xrr_condition_report_update
_G.xrr_condition_report_flush  = xrr_condition_report_flush
