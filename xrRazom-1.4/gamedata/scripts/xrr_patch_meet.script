--[[
  xrRazom — STALKER Anomaly Co-op
  Разом нас багато. (Together we are many.)

  Host-side: extends xr_meet's db.actor-only reactions (greet/bye, threat_na, gtfo,
  commander_threat) and the peer talk gate to peer proxies.
]]

local _orig_mm_update         = nil
local _orig_mm_update_state   = nil
local _orig_mm_set_start_dist = nil
local _orig_eva_evaluate      = nil
local _orig_act_execute       = nil
local _orig_actor_is_safemode = nil
local _orig_actor_has_weapon  = nil
local _orig_process_npc_usability = nil

-- Same set the vanilla evaluator uses to suppress gtfo during animpoints.
local good_acts = { [xr_actions_id.animpoint_action + 1] = true }

-- Plain-global reads: this runs per NPC per motivator update.
local function meet_sync_active()
    return XrrHosting and XrrPeerCount > 0
end

-- A per-frame cache: never hold its table past the frame.
local alive_proxies = xrr_patch_common.alive_proxies

local function nearest_player(pos)
    local best, best_d = db.actor, db.actor and db.actor:alive()
        and db.actor:position():distance_to_sqr(pos) or math.huge
    local proxies = alive_proxies()
    for i = 1, #proxies do
        local d = proxies[i]:position():distance_to_sqr(pos)
        if d < best_d then best, best_d = proxies[i], d end
    end
    return best
end

local function any_player_seen_or_near(npc, dist_sqr)
    local npc_pos = npc:position()
    if db.actor and db.actor:alive()
        and (npc:see(db.actor) or db.actor:position():distance_to_sqr(npc_pos) <= dist_sqr) then
        return true
    end
    local proxies = alive_proxies()
    for i = 1, #proxies do
        local p = proxies[i]
        if npc:see(p) or p:position():distance_to_sqr(npc_pos) <= dist_sqr then
            return true
        end
    end
    return false
end

-- Copy of xr_meet's file-local get_vertex (not exported).
local function get_vertex(npc)
    local rnd1, ang = math.random(100)
    if rnd1 < 43 then
        ang = math.random(50, 60)
    elseif rnd1 < 58 then
        ang = math.random(160, 200)
    else
        ang = math.random(300, 310)
    end
    local dir = vector_rotate_y(npc:direction(), ang)
    return npc:vertex_in_direction(npc:level_vertex_id(), dir, math.random(4, 6))
end

local function pick_num(who, npc, condlist, def)
    return tonumber(xr_logic.pick_section_from_condlist(who, npc, condlist)) or def
end

local function mm_update(self)
    if not meet_sync_active() then
        self.xrr_focus_id = nil
        return _orig_mm_update(self)
    end

    -- Pre-check the original's 500ms throttle so the overlay runs on the same cadence.
    local tg = time_global()
    if self.__stimer and tg < self.__stimer then return end

    -- db.actor-only by design: peer dialog goes through NPC_LOCK.
    _orig_mm_update(self)

    local npc = self.npc
    local npc_pos = npc:position()
    local proxies = alive_proxies()

    local focus_id, focus_state = nil, self.current_distance
    local focus_dist = math.huge
    if focus_state then
        focus_id = AC_ID
        if db.actor then focus_dist = db.actor:position():distance_to(npc_pos) end
    end

    if #proxies == 0 then
        self.xrr_focus_id = focus_id
        return
    end

    self.xrr_flags = self.xrr_flags or {}
    local in_combat = state_mgr.is_npc_in_combat(npc)

    for i = 1, #proxies do
        local p = proxies[i]
        local pid = p:id()
        local dist = npc_pos:distance_to(p:position())
        local visible = npc:see(p)
        local fl = self.xrr_flags[pid]
        if not fl then fl = {}; self.xrr_flags[pid] = fl end

        if visible then
            if dist <= pick_num(p, npc, self.a.close_snd_distance, 0) then
                if not fl.hello then
                    fl.hello = true
                    if not in_combat then
                        local snd = self.a.close_snd_hello
                            and xr_logic.pick_section_from_condlist(p, npc, self.a.close_snd_hello)
                        if snd and snd ~= "nil" and snd ~= "" then
                            xr_sound.set_sound_play(npc:id(), snd)
                        end
                    end
                end
            elseif dist <= pick_num(p, npc, self.a.far_snd_distance, 0) then
                if fl.hello and not fl.bye then
                    fl.bye = true
                    if not in_combat then
                        local snd = self.a.close_snd_bye
                            and xr_logic.pick_section_from_condlist(p, npc, self.a.close_snd_bye)
                        if snd and snd ~= "nil" and snd ~= "" then
                            xr_sound.set_sound_play(npc:id(), snd)
                        end
                    end
                end
            end
        end

        local is_close = visible and dist <= pick_num(p, npc, self.a.close_distance, 3)
        local is_far   = visible and dist <= pick_num(p, npc, self.a.far_distance, 5)

        if is_close then
            if focus_state ~= "close" or dist < focus_dist then
                focus_id, focus_state, focus_dist = pid, "close", dist
            end
        elseif is_far then
            if not focus_state or (focus_state == "far" and dist < focus_dist) then
                focus_id, focus_state, focus_dist = pid, "far", dist
            end
        elseif dist > self.a.reset_distance then
            fl.hello = false
            fl.bye = false
        end
    end

    self.current_distance = focus_state
    self.xrr_focus_id = focus_id
end

local function mm_update_state(self)
    local fid = self.xrr_focus_id
    if not (meet_sync_active() and fid and fid ~= AC_ID) then
        return _orig_mm_update_state(self)
    end

    -- The proxy can be released between update() ticks (disconnect / level change).
    local focus = level.object_by_id(fid)
    if not (focus and focus:alive()) then
        self.xrr_focus_id = nil
        return _orig_mm_update_state(self)
    end

    local npc = self.npc
    local condlist = self.current_distance == "close" and self.a.close_anim or self.a.far_anim
    local state = condlist and xr_logic.pick_section_from_condlist(focus, npc, condlist)

    if state and state ~= "nil" and state ~= "" then
        local victim_str = xr_logic.pick_section_from_condlist(focus, npc,
            self.current_distance == "close" and self.a.close_victim or self.a.far_victim)
        -- "actor" in a meet profile means "the player being met" — here the proxy.
        local victim
        if victim_str == "actor" then
            victim = focus
        else
            victim = get_story_object(victim_str)
        end
        state_mgr.set_state(npc, state, nil, nil, {look_object = victim})
    end

    local snd = self.a.far_snd and xr_logic.pick_section_from_condlist(focus, npc, self.a.far_snd)
    if snd and snd ~= "nil" and snd ~= "" then
        xr_sound.set_sound_play(npc:id(), snd)
    end
end

local function mm_set_start_distance(self)
    _orig_mm_set_start_dist(self)
    if not meet_sync_active() then return end
    if not self.npc:alive() then return end

    -- Vanilla's "already in range at scheme init → don't greet" seeding, per peer.
    local npc = self.npc
    local npc_pos = npc:position()
    local proxies = alive_proxies()
    if #proxies == 0 then return end

    self.xrr_flags = self.xrr_flags or {}
    for i = 1, #proxies do
        local p = proxies[i]
        local pid = p:id()
        local dist = npc_pos:distance_to(p:position())
        local visible = npc:see(p)
        local is_far   = visible and dist <= pick_num(p, npc, self.a.far_distance, 5)
        local is_close = visible and dist <= pick_num(p, npc, self.a.close_distance, 3)
        local fl = self.xrr_flags[pid]
        if not fl then fl = {}; self.xrr_flags[pid] = fl end
        if is_close then
            fl.hello = true
        elseif is_far then
            fl.bye = true
        elseif dist > self.a.reset_distance then
            fl.hello = false
            fl.bye = false
        end
    end
end

local function eva_evaluate(self)
    if not meet_sync_active() then
        return _orig_eva_evaluate(self)
    end

    if not self.object:alive() then return false end
    if self.a.meet_set ~= true then return false end
    if not db.actor then return false end
    if not db.actor:alive() then return false end

    self.a.meet_manager:update()

    if db.storage[self.object:id()].victim_surrender == AC_ID then
        return true
    end

    if xr_wounded.is_wounded(self.object) then return false end
    if self.object:best_enemy() ~= nil then return false end

    local state = state_mgr.get_state(self.object)
    if state == "search_corpse" or state == "pickup_crouch" then return false end

    if (self.object:has_info("npcx_is_companion") or not get_object_story_id(self.object:id()))
        and not self.object:is_talking() then
        if self.a.gtfo == true then
            return true
        end
        if xrr_patch_common.nearest_player_dist_sqr(self.object:position()) < 1.5
            and not good_acts[utils_obj.get_current_action_id(self.object)] then
            self.a.dtimer = not self.a.dtimer and time_global() + 4000 or self.a.dtimer
            if time_global() > self.a.dtimer then
                self.a.dtimer = nil
                self.a.gtfo = true
                return true
            end
        end
    end

    local squad = self.object and get_object_squad(self.object)
    local commander = squad and squad:commander_id() ~= self.object:id()
        and level.object_by_id(squad:commander_id())
    if commander and state_mgr.get_state(commander) == "threat_na"
        and utils_obj.get_current_action_id(commander) == xr_actions_id.stohe_meet_base + 1 then
        if any_player_seen_or_near(self.object, 225) then
            self.a.commander_threat = true
            return true
        end
    else
        self.a.commander_threat = nil
    end

    return self.a.meet_manager.current_distance ~= nil
end

local function act_execute(self)
    if not meet_sync_active() then
        return _orig_act_execute(self)
    end

    action_base.execute(self)
    local npc = self.object

    if self.a.gtfo and self.a.can_gtfo == 'true' then
        if npc:is_talking() or xrr_patch_common.nearest_player_dist_sqr(npc:position()) > 4 then
            utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id())
            self.a.gtfo = nil
            self.a.vertex_id = nil
            self.a.stage = 0
            return
        end
        if self.a.stage == 0 then
            self.a.vertex_id = utils_obj.try_go_backward(npc, 5, self.a.vertex_id)
            if self.a.vertex_id then
                npc:set_desired_direction()
                state_mgr.set_state(npc, "patrol")
                self.a.stage = 1
                self.a.dtimer = time_global() + 4000
            end
        elseif self.a.stage == 1 then
            if npc:level_vertex_id() == self.a.vertex_id or time_global() > self.a.dtimer then
                self.a.gtfo = nil
                self.a.vertex_id = nil
                self.a.stage = 0
                return
            end
            utils_obj.send_to_nearest_accessible_vertex(npc, self.a.vertex_id)
        end
        return
    elseif self.a.commander_threat then
        local target = nearest_player(npc:position()) or db.actor
        if self.a.stage == 0 then
            if utils_obj.squad_in_los(npc, target) then
                npc:set_desired_direction()
                state_mgr.set_state(npc, "rush")
                self.a.stage = 1
                return
            else
                utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id(), "xr_meet")
            end
        elseif self.a.stage == 1 then
            state_mgr.set_state(npc, "rush")

            local squad = get_object_squad(npc)
            local commander = squad and squad:commander_id()
                and level.object_by_id(squad:commander_id())
            self.a.vertex_id = (commander and get_vertex(commander)) or npc:level_vertex_id()
            self.a.vertex_id = utils_obj.send_to_nearest_accessible_vertex(npc, self.a.vertex_id, "xr_meet")

            self.a.dtimer = time_global() + 3000
            self.a.stage = 2
            return
        elseif self.a.stage == 2 then
            npc:set_desired_direction()
            state_mgr.set_state(npc, "rush")
            if npc:level_vertex_id() == self.a.vertex_id then
                self.a.stage = 0
            else
                if time_global() > self.a.dtimer then
                    self.a.stage = 0
                end
            end
            return
        end
        npc:set_desired_direction()
        state_mgr.set_state(self.object, "threat_na", nil, nil, {look_object = target})
        return
    end
    self.a.meet_manager:update_state()
end

local function patched_actor_is_safemode(actor, npc)
    if XrrPeerCount > 0 and actor and XrrHosting then
        local id = actor:id()
        if id ~= AC_ID and XrrPlayers():IsPlayerDummy(id) then
            return XrrPlayers():IsProxySafemode(id)
        end
    end
    return _orig_actor_is_safemode(actor, npc)
end

local function patched_actor_has_weapon(actor, npc)
    if XrrPeerCount > 0 and actor and XrrHosting then
        local id = actor:id()
        if id ~= AC_ID and XrrPlayers():IsPlayerDummy(id) then
            local obj = actor:active_item()
            return obj ~= nil and IsWeapon(obj)
                and not XrrPlayers():IsProxyWeaponStrapped(id)
        end
    end
    return _orig_actor_has_weapon(actor, npc)
end

-- init_meet bakes the enemy-vs-normal profile against db.actor once; the two
-- talk-relevant fields are re-derived per player, greeting/anim keep the baked one.

-- Non-enemy default strings, verbatim from xr_meet.init_meet.
local DEF_USE        = "{=is_wounded} false, {!is_squad_commander} false, {=actor_enemy} false, {=has_enemy} false, {=dist_to_actor_le(3)} true, false"
local DEF_SND_ON_USE = "{=is_wounded} nil, {!is_squad_commander} meet_use_no_talk_leader, {=actor_enemy} nil, {=has_enemy} meet_use_no_fight, {!dist_to_actor_le(3)} nil"

-- NEVER the character_community() global on an avatar: its IsStalker test excludes
-- XRRAVATR and answers "monster", enemy to every faction.
local function player_faction(who)
    local c = who:character_community() or ""
    if c:sub(1, 6) == "actor_" then c = c:sub(7) end
    return c ~= "" and c or "stalker"
end

local function is_enemy_for(npc, who)
    return game_relations.is_factions_enemies(player_faction(who), character_community(npc))
        or game_relations.get_npcs_relation(npc, who) == game_object.enemy
end

-- init_meet's NON-enemy use / snd_on_use condlists. Keyed on the ini object +
-- section so id recycling and profile switches rebuild.
local peer_meet_cache = {}

local function peer_meet_condlists(npc, meet)
    local ms = meet.meet_section or "nil"
    if ms == "no_meet" then return nil end
    local st = db.storage[npc:id()]
    local ini = st and st.ini
    if not ini then return nil end

    local id = npc:id()
    local c = peer_meet_cache[id]
    if not (c and c.ms == ms and c.ini == ini) then
        c = {
            ms           = ms,
            ini          = ini,
            use          = ini:r_string_to_condlist(ms, "use", DEF_USE),
            snd          = ini:r_string_to_condlist(ms, "snd_on_use", DEF_SND_ON_USE),
            use_explicit = ini:r_string_ex(ms, "use") ~= nil,
            snd_explicit = ini:r_string_ex(ms, "snd_on_use") ~= nil,
        }
        peer_meet_cache[id] = c
    end
    return c
end

-- Mirrors xr_meet.notify_on_use so the threat reaction clears.
function xrr_on_peer_npc_talk(npc_id)
    local st = db.storage[npc_id]
    if st then
        st.after_first_meet = true
    end
end

-- Mirrors xr_meet.notify_on_use with the proxy as the actor, so the NPC answers
-- its vanilla refusal line. Abuse accounting stays host-actor-only on purpose.
function xrr_on_peer_npc_talk_refused(npc_id, who_id)
    local npc = level.object_by_id(npc_id)
    local who = level.object_by_id(who_id)
    if not (npc and who and npc:alive()) then return end

    local storage = db.storage[npc_id]
    if not storage then return end
    storage.after_first_meet = true

    local meet = storage.meet
    if not meet then return end

    local cls = peer_meet_condlists(npc, meet)
    local snd_cl
    if cls and cls.snd_explicit then
        snd_cl = cls.snd
    elseif is_enemy_for(npc, who) then
        snd_cl = nil
    else
        snd_cl = cls and cls.snd or meet.snd_on_use
    end
    if not snd_cl then return end

    local snd = xr_logic.pick_section_from_condlist(who, npc, snd_cl)
    if snd and snd ~= "" and snd ~= "nil" then
        xr_sound.set_sound_play(npc_id, snd)
    end
end

-- process_npc_usability's decision with a PLAYER in place of db.actor. Known hole:
-- re-evaluating `use` double-fires any %effect% a modded condlist carries.
-- The reason string is built only with want_reason: the broadcast runs twice a second.
local function can_peer_talk_eval(npc, who, want_reason)
    if character_community(npc) == "zombied" then return false, "zombied" end

    local st = db.storage[npc:id()]

    if IsWounded(npc) then
        if npc:relation(who) >= game_object.enemy
            and st and st.victim_surrender ~= who:id() then
            return false, "wounded + enemy"
        end
        local wounded = st and st.wounded
        if wounded and wounded.enable_talk then return true end
        return false, "wounded, enable_talk unset"
    end

    if npc:section() == "mar_smart_terrain_doc_doctor" then return true end

    local mm = st and st.meet and st.meet.meet_manager
    if not (mm and mm.a and mm.a.use) then return true end

    local cls = peer_meet_condlists(npc, mm.a)
    local use, enemy_prof
    if cls and cls.use_explicit then
        use = xr_logic.pick_section_from_condlist(who, npc, cls.use)
    elseif is_enemy_for(npc, who) then
        use, enemy_prof = "false", true
    else
        use = xr_logic.pick_section_from_condlist(who, npc, cls and cls.use or mm.a.use)
    end
    if mm.npc_is_camp_director == true then use = "false" end
    use = load_var(db.actor, "force_all_talk", false) and "true" or use

    -- Vanilla suppresses only "true"; "self" (NPC-initiated dialog) stays talkable.
    if use == "true" then
        if xr_corpse_detection.is_under_corpse_detection(npc)
            or xr_help_wounded.is_under_help_wounded(npc) then
            return false, "corpse/help-wounded suppression"
        end
        return true
    end
    if use == "self" then return true end

    local id = npc:id()
    local task_info = task_manager.get_task_manager().task_info
    for k, v in pairs(task_info) do
        if v.task_giver_id and v.task_giver_id == id then
            return true
        elseif tasks_delivery.is_delivery_task(k) then
            local var = load_var(db.actor, k)
            if var and var.target_id and var.target_id == id then
                return true
            end
        end
    end

    if use ~= "false" then return true end

    -- Vanilla answers "false" with disable_talk, so a talk-enabled NPC under a cached
    -- "false" means a more permissive mod gate (GAMMA Modular Tweaks) is installed.
    if mm.use == "false" and npc:is_talk_enabled() then return true end

    if not want_reason then return false end
    return false, string.format(
        "use=false meet=%s explicit=%s enemy_prof=%s dist=%.1f has_enemy=%s camp_dir=%s host_use=%s talk_enabled=%s",
        tostring(mm.a.meet_section), tostring(cls and cls.use_explicit or false),
        tostring(enemy_prof or false), who:position():distance_to(npc:position()),
        tostring(npc:best_enemy() ~= nil), tostring(mm.npc_is_camp_director == true),
        tostring(mm.use), tostring(npc:is_talk_enabled()))
end

-- Host dialog gate: the engine calls this from handle_npc_lock with the
-- requesting peer's proxy. Fail-open — alive + enemy were already checked.
function xrr_can_peer_talk(npc_id, who_id)
    local npc = level.object_by_id(npc_id)
    local who = level.object_by_id(who_id)
    if not (npc and who and npc:alive()) then return true end
    local ok, reason = can_peer_talk_eval(npc, who, true)
    if ok ~= true then
        log(string.format("[xrRazom] peer talk refused: %s id=%d - %s",
            npc:section(), npc_id, reason or "?"))
    end
    return ok == true
end

-- utils_obj.is_trader's explicit `trade`-line path, the only one a mirror can't evaluate.
local function declares_trade(npc)
    local st = db.storage[npc:id()]
    local ini, logic = st and st.ini, st and st.section_logic
    return (ini and logic and ini:section_exist(logic)
            and ini:line_exist(logic, "trade")) and true or false
end

-- C++ dedupes these and broadcasts only flips.
local flags_next = {}

local function eval_peer_flags(npc, who)
    local t = can_peer_talk_eval(npc, who)   -- truncated to its first return
    return t, declares_trade(npc)
end

local function push_peer_npc_flags(npc)
    local id = npc:id()
    local tg = time_global()
    if flags_next[id] and tg < flags_next[id] then return end
    flags_next[id] = tg + 500

    local proxies = alive_proxies()
    if #proxies == 0 then return end
    local npc_pos = npc:position()
    local who, best = nil, math.huge
    for i = 1, #proxies do
        local d = proxies[i]:position():distance_to_sqr(npc_pos)
        if d < best then who, best = proxies[i], d end
    end
    -- A modded condlist choking on a proxy actor must not abort the host's NPC binder
    -- tick; on error the last pushed flags stand.
    local ok, talk, trader = pcall(eval_peer_flags, npc, who)
    if ok then
        XrrAlife():SetNpcFlags(id, talk == true, trader == true)
    end
end

-- A peer-requested level change tears down db.storage[id] while the NPC binder gets
-- one more update, where vanilla indexes the nil storage and CTDs.
local function process_npc_usability(npc)
    if XrrSessionActive and not db.storage[npc:id()] then
        return
    end
    -- Order matters: can_peer_talk_eval reads this tick's talk-enabled state.
    _orig_process_npc_usability(npc)
    if meet_sync_active() and npc:alive() then
        push_peer_npc_flags(npc)
    end
end

function on_game_start()
    if not (xr_meet and xr_meet.Cmeet_manager and xr_meet.evaluator_contact
            and xr_meet.action_meet_wait) then
        log("[xrRazom] meet sync: xr_meet classes missing — skipped")
        return
    end

    _orig_mm_update         = xr_meet.Cmeet_manager.update
    _orig_mm_update_state   = xr_meet.Cmeet_manager.update_state
    _orig_mm_set_start_dist = xr_meet.Cmeet_manager.set_start_distance
    xr_meet.Cmeet_manager.update             = mm_update
    xr_meet.Cmeet_manager.update_state       = mm_update_state
    xr_meet.Cmeet_manager.set_start_distance = mm_set_start_distance

    _orig_eva_evaluate = xr_meet.evaluator_contact.evaluate
    xr_meet.evaluator_contact.evaluate = eva_evaluate

    _orig_act_execute = xr_meet.action_meet_wait.execute
    xr_meet.action_meet_wait.execute = act_execute

    _orig_actor_is_safemode = xr_conditions.actor_is_safemode
    xr_conditions.actor_is_safemode = patched_actor_is_safemode

    _orig_actor_has_weapon = xr_conditions.actor_has_weapon
    xr_conditions.actor_has_weapon = patched_actor_has_weapon

    if xr_meet.process_npc_usability then
        _orig_process_npc_usability = xr_meet.process_npc_usability
        xr_meet.process_npc_usability = process_npc_usability
    end

    log("[xrRazom] meet sync: NPC greet/threat reactions extended to peer proxies")
end

_G.xrr_on_peer_npc_talk         = xrr_on_peer_npc_talk
_G.xrr_on_peer_npc_talk_refused = xrr_on_peer_npc_talk_refused
_G.xrr_can_peer_talk            = xrr_can_peer_talk
